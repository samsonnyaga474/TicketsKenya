# ============================================================
# TicketsKenya — private settings template
# ============================================================
# 1. Copy this file to a new file named exactly: .env
#    (same folder as this file — the project root, NOT public/)
# 2. Fill in real values only in .env
# 3. Never commit .env to Git or share it in chat/screenshots
# ============================================================

TK_ENV=development
TK_APP_URL=http://localhost:8080
TK_DEMO_MODE=true

# Public support email (shown on the site)
TK_SUPPORT_EMAIL=ticketskenyasupport@gmail.com

# --- Pesapal API 3.0 ---
# Use sandbox first. Get key + secret from your Pesapal merchant/developer area.
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
# After you run: php tools/register-pesapal-ipn.php https://YOUR-PUBLIC-HTTPS-DOMAIN/payments/webhook.php
# paste the returned ipn_id here:
PESAPAL_NOTIFICATION_ID=

# Optional platform fee percent (default 5)
# TK_PLATFORM_FEE_PERCENT=5.0

# When you go live later (only after sandbox tests pass):
# PESAPAL_ENV=live
# TK_ENV=production
# TK_DEMO_MODE=false
# TK_APP_URL=https://your-real-domain.example
