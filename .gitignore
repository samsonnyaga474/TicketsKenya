# Environment and secrets (never commit real values)
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# Databases and application data
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
data/*
!data/.gitkeep
data/*.lock
data/*.log
data/*.json.tmp

# Backups and local working data
/work/
backups/
*.bak
*.old

# Logs and temporary files
*.log
*.tmp
*.cache

# User uploads, but keep the protective .htaccess part of the repository
public/assets/uploads/*
!public/assets/uploads/.htaccess

# Test and tooling caches
__pycache__/
*.pyc
.pytest_cache/
vendor/
node_modules/
.cache/

# Operating system files
.DS_Store
Thumbs.db
